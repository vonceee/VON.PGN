/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./src",
    "paths": {
      "environments/*": ["src/environments/*"],
      "@shared/ui": ["src/app/shared/components/ui/index"],
      "@shared/chess": ["src/app/shared/components/chess/index"],
      "@shared/layout": ["src/app/shared/components/layout/index"],
      "@shared/feedback": ["src/app/shared/components/feedback/index"],
      "@shared/directives": ["src/app/shared/directives/index"]
    },
    "outDir": "./out-tsc/app",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
